{
  "name": "@particle-academy/fancy-captcha-ui",
  "version": "0.2.0",
  "description": "One provider-agnostic React captcha for fancy-captcha: built-in honeypot, signed timing and Web Worker proof-of-work, or Turnstile, reCAPTCHA and hCaptcha loaded lazily and SSR-safe, with optional consent gating. Built from react-fancy, AAA and RTL. Agents may read its status, never solve it.",
  "keywords": [
    "captcha",
    "bot-protection",
    "honeypot",
    "proof-of-work",
    "turnstile",
    "recaptcha",
    "hcaptcha",
    "react",
    "inertia",
    "accessibility",
    "rtl",
    "human-plus",
    "particle-academy"
  ],
  "homepage": "https://github.com/Particle-Academy/fancy-captcha-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-captcha-ui.git"
  },
  "bugs": "https://github.com/Particle-Academy/fancy-captcha-ui/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsup"
  },
  "peerDependencies": {
    "@particle-academy/react-fancy": ">=6.11.0 <7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@particle-academy/react-fancy": "^6.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "source-map-js": "^1.2.2"
  },
  "engines": {
    "node": ">=22"
  }
}
